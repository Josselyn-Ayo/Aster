# ASTER — ejemplo de variables de entorno (no commitear el .env real)
# Copia a `.env` en la raíz para desarrollo. En producción la URI se puede
# pegar desde Ajustes → Datos (se guarda en db_config.json del app-data).

# Connection string de Mongo Atlas (Database → Connect → Drivers → Rust).
# Ejemplo: mongodb+srv://aster-app:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Base de datos (colecciones: audits, metrics, profiles, conversations).
MONGODB_DB=aster

# --- Proveedores de IA ---
# El backend lee estas variables con dotenvy y las expone por IPC, así que NO
# se incrustan en el bundle del instalador. Ajustes → IA puede sobrescribirlas.
#
# Gemini: conversación, visión, transcripción, imágenes y búsqueda con Google.
GEMINI_API_KEY=
# Groq: conversación rápida y transcripción (Whisper). Cuota independiente.
GROQ_API_KEY=
# Opcionales (solo si los añades a la cadena de respaldo en Ajustes → IA).
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Compatibilidad con el frontend antiguo: si usas `vite dev` sin Tauri, la
# clave de Gemini se puede inyectar por Vite con este nombre.
VITE_GEMINI_API_KEY=
