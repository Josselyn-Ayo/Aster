{
  "name": "aster-desktop-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "bench": "node -e \"require('node:fs').rmSync('docs/perf/raw/frontend-bench.jsonl',{force:true})\" && vitest run --config vitest.bench.config.ts",
    "bench:rust": "cargo bench --manifest-path src-tauri/Cargo.toml --profile perf",
    "perf:report": "node scripts/perf/report.mjs",
    "perf:criterion": "node scripts/perf/criterion.mjs",
    "perf:recursos": "powershell -ExecutionPolicy Bypass -File scripts/perf/recursos.ps1",
    "perf:export": "node scripts/perf/export.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@tauri-apps/api": "^2.12.1",
    "mongodb": "^7.7.0",
    "motion": "^14.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "docx": "^9.15.3",
    "md-to-pdf": "^5.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tinybench": "^6.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.3"
  }
}
